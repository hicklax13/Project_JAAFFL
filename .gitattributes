# Normalize line endings: LF in the repo AND in working copies on every platform.
# (CI regenerates packages/shared/schemas and runs `git diff --exit-code` — CRLF
# checkouts would phantom-diff otherwise.)
* text=auto eol=lf

# Windows-only files keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries — never normalize.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.parquet binary
*.sqlite binary
