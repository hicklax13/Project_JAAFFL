# Copy to .env and fill in as you enable each stage. Never commit .env.

# ── Backend companion service ────────────────────────────────────────────────
JAAFFL_API_HOST=127.0.0.1
JAAFFL_API_PORT=8788
JAAFFL_LOG_LEVEL=INFO
JAAFFL_DATA_DIR=./data

# Pre-draft precompute bridge (§4.7) — ON by default, so a fresh clone reaches a real
# GET /recommendation with no extra setup. It fails soft: with no player universe or no
# projections the endpoint 503s "warming up" rather than serving a hollow board. Set false only
# to pin that warming-up state deliberately (e.g. an offline demo). All provider network happens
# lazily inside precompute; the per-pick hot path never touches a provider.
JAAFFL_PRECOMPUTE_ENABLED=true

# YOUR draft slot, as CBS numbers the teams in the room ("1".."12"). SET THIS BEFORE DRAFT NIGHT.
# No CBS frame names the viewer's own team, so the app cannot work it out from the live feed.
# Without it the engine cannot tell when your next pick is: survival degrades to "everyone is
# still available" and VONA reads 0.00 on every recommendation the overlay is pushed. It still
# ranks (on Marginal Lineup Value) and it says so — the recommendation carries
# survival_basis="degraded_no_slot" and the overlay foot shows "VONA degraded · no draft slot
# set" — but the scarcity half of the model is off until this is set. `GET /recommendation`
# also accepts ?team_id= per call, which overrides this.
JAAFFL_MY_TEAM_ID=

# ── Data providers (Stage 4) ─────────────────────────────────────────────────
# $0 prototype = nflverse (free, no key) + CBS on-page data via the extension.
# Everything below is an opt-in PAID upgrade and stays OFF by default.

# FantasyPros — personal, non-commercial Premium tier. Leave blank to disable.
FANTASYPROS_API_KEY=
JAAFFL_ENABLE_FANTASYPROS=false

# Commercial real-time providers (optional; off by default). Require a license.
SPORTSDATAIO_API_KEY=
JAAFFL_ENABLE_SPORTSDATAIO=false
SPORTRADAR_API_KEY=
JAAFFL_ENABLE_SPORTRADAR=false

# Unofficial/deprecated CBS API adapter. Off by default — see
# docs/legal-and-compliance.md before ever enabling this.
JAAFFL_ENABLE_CBS_UNOFFICIAL_API=false

# ── AI assistant (Stage 7) — OpenAI Responses API ────────────────────────────
# Text-only. Voice/Realtime is out of scope for the prototype (see docs/adr/0003).
# AI usage is the one cost the prototype allows.
OPENAI_API_KEY=
JAAFFL_ASSISTANT_MODEL=gpt-4.1-mini
JAAFFL_ASSISTANT_ENABLE_WEB_SEARCH=false

# ── Web dashboard ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8788
