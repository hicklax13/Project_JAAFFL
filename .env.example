# Copy to .env and fill in as you enable each stage. Never commit .env.

# ── Backend companion service ────────────────────────────────────────────────
JAAFFL_API_HOST=127.0.0.1
JAAFFL_API_PORT=8787
JAAFFL_LOG_LEVEL=INFO
JAAFFL_DATA_DIR=./data

# ── Data providers (Stage 4) ─────────────────────────────────────────────────
# $0 prototype = nflverse (free, no key) + CBS on-page data via the extension.
# Everything below is an opt-in PAID upgrade and stays OFF by default.

# FantasyPros — personal, non-commercial Premium tier. Leave blank to disable.
FANTASYPROS_API_KEY=
JAAFFL_ENABLE_FANTASYPROS=false

# Commercial real-time providers (optional; off by default). Require a license.
SPORTSDATAIO_API_KEY=
JAAFFL_ENABLE_SPORTSDATAIO=false
SPORTRADAR_API_KEY=
JAAFFL_ENABLE_SPORTRADAR=false

# Unofficial/deprecated CBS API adapter. Off by default — see
# docs/legal-and-compliance.md before ever enabling this.
JAAFFL_ENABLE_CBS_UNOFFICIAL_API=false

# ── AI assistant (Stage 7) — OpenAI Responses API ────────────────────────────
# Text-only. Voice/Realtime is out of scope for the prototype (see docs/adr/0003).
# AI usage is the one cost the prototype allows.
OPENAI_API_KEY=
JAAFFL_ASSISTANT_MODEL=gpt-4.1-mini
JAAFFL_ASSISTANT_ENABLE_WEB_SEARCH=false

# ── Web dashboard ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787
