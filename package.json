{
  "name": "jaaffl",
  "version": "0.0.0",
  "private": true,
  "description": "CBS Fantasy Football Live Draft Assistant — JS/TS workspace (extension, web, shared).",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter @jaaffl/web dev",
    "dev:ext": "pnpm --filter @jaaffl/extension dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\""
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
