      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Position"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Restrict to positions, or None for all.",
      "title": "Applies To"
    },
    "points_per_unit": {
      "title": "Points Per Unit",
      "type": "number"
    },
    "stat": {
      "title": "Stat",
      "type": "string"
    }
  },
  "required": [
    "stat",
    "points_per_unit"
  ],
  "title": "ScoringRule",
  "type": "object"
}
