{
  "$defs": {
    "Position": {
      "enum": [
        "QB",
        "RB",
        "WR",
        "TE",
        "K",
        "DST",
        "DL",
        "LB",
        "DB"
      ],
      "title": "Position",
      "type": "string"
    }
  },
  "description": "Points awarded per unit of a stat, e.g. stat='reception', points_per_unit=1.0 (PPR).",
