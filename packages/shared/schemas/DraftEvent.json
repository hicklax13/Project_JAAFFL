{
  "$defs": {
    "DraftEventSource": {
      "description": "Which capture probe won (\u00a75.4): MAIN-world network patch, React-fiber read,\nMutationObserver DOM fallback, or the manual-paste fallback.",
      "enum": [
        "ws",
        "framework",
        "dom",
        "paste"
      ],
      "title": "DraftEventSource",
      "type": "string"
    },
    "DraftEventType": {
      "enum": [
        "league_settings",
        "draft_state",
        "on_the_clock",
        "pick_made",
        "draft_complete"
      ],
      "title": "DraftEventType",
      "type": "string"
    }
  },
  "description": "A normalized event emitted by the extension and ingested by the backend.\n\n``data`` is validated by ``jaaffl.ingest`` into the concrete model for its type.",
  "properties": {
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "event_type": {
      "$ref": "#/$defs/DraftEventType"
    },
    "league_id": {
      "title": "League Id",
      "type": "string"
    },
    "pick_number": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pick Number"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/DraftEventSource"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Winning probe: ws | framework | dom | paste."
    }
  },
  "required": [
    "event_type",
    "league_id"
  ],
  "title": "DraftEvent",
  "type": "object"
}
